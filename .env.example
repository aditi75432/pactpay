# Copy to apps/web/.env.local  (Windows: copy .env.example apps\web\.env.local)
# Only the three PayPal/DB lines and one AI key are needed to run the full workflow.

# --- Database (docker compose up via `pnpm db:up`) ---
DATABASE_URL=postgres://pactpay:pactpay_dev_only@127.0.0.1:5432/pactpay

# --- PayPal Sandbox: https://developer.paypal.com/dashboard/applications/sandbox ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: webhook id from your Sandbox app, enables signed-webhook reconciliation
PAYPAL_WEBHOOK_ID=

# --- AI: any one provider below. Rules, agent, inspector and Guard's screenshot reader use it ---
MODEL_API_KEY=                 # Meta Model API (Muse Spark 1.3, Muse Voice Transcribe)
# META_MODEL=
# META_API_BASE_URL=
# AI_PROVIDER=baseten          # use Muse Spark Open on Baseten instead
# BASETEN_API_KEY=
# AI_TIMEOUT_MS=40000

# --- Live product catalog (Channel3) ---
CHANNEL3_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
PACTPAY_REQUIRE_LOGIN=0   # local: guests allowed. Hosted deployments set 1
PACTPAY_DEMO_USERNAME=judge
PACTPAY_DEMO_PASSWORD=PactPay-Judge-2026
PACTPAY_SHOW_DEMO_CREDENTIALS=1
# PACTPAY_COOKIE_SECURE=1        # set behind https

# --- PactPay Guard extension ---
# Let anonymous Quick Guard calls also use the AI screenshot reader (costs model tokens). Default off.
# PACTPAY_GUARD_QUICK_VISION=1

# --- Judge page (/judges) ---
# Shows the PayPal Sandbox BUYER test login to judges. Fake sandbox account only. Baked in at build time.
# NEXT_PUBLIC_SANDBOX_BUYER_EMAIL=
# NEXT_PUBLIC_SANDBOX_BUYER_PASSWORD=
