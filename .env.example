# Copy this file to apps/web/.env.local and fill in your own values. Never commit real secrets.

# Local PostgreSQL started by `pnpm db:up` (see docker-compose.yml).
DATABASE_URL=postgres://pactpay:pactpay_dev_only@localhost:5432/pactpay

# PayPal Sandbox REST app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: only needed if you expose /api/webhooks/paypal on a public URL.
PAYPAL_WEBHOOK_ID=

# Where PayPal sends the buyer back after approval. Use your public https URL when hosted.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Live product catalog (https://www.channel3.com)
CHANNEL3_API_KEY=

# AI: turns plain-language requests into rules and rewrites block explanations.
# Without a key the app falls back to a basic parser and plain templates, and labels them as such.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Accounts -----------------------------------------------------------------------------------
# Hosted deployments require sign-in. Leave unset locally to allow guest use.
# PACTPAY_REQUIRE_LOGIN=1
# A shared demo account for reviewers (created at startup if it doesn't exist). The README lists the same pair.
# PACTPAY_DEMO_USERNAME=judge
# PACTPAY_DEMO_PASSWORD=PactPay-Judge-2026
# Show the demo credentials on the sign-in page (public sandbox demos only).
# PACTPAY_SHOW_DEMO_CREDENTIALS=1
# Re-enable the old $1 test endpoint (development only; off by default).
# PACTPAY_ENABLE_LEGACY_ROUTES=1

# --- Optional hardening / ops switches ---------------------------------------------------------
# Show every visitor's activity in the Control Center (private operator deployments only).
# PACTPAY_CONTROL_CENTER_SCOPE=all
# Turn off the in-memory rate limits (local load testing only).
# PACTPAY_RATE_LIMIT_DISABLED=1
# Force the session cookie to be Secure behind a proxy that doesn't send x-forwarded-proto.
# PACTPAY_COOKIE_SECURE=1
# Development only: accept a browser-supplied Pact instead of a server-stored approval.
# Leave unset. It weakens the central guarantee.
# PACTPAY_ALLOW_CLIENT_PACT=1
