# Copy to apps/web/.env.local and fill in. Never commit real keys.

# --- Meta (the AI behind every feature) ---------------------------------------
# Meta Model API key from https://dev.meta.ai  (Muse Spark, Muse Voice Transcribe)
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Optional: Muse Spark Open (open weights) served by Baseten. When both keys are set,
# the Checkout Inspector uses the two Meta models as independent readers.
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open
# Optional: force one provider ("meta" or "baseten"). Default: meta, then baseten.
AI_PROVIDER=
# Optional: per-call timeout in ms. Leave this line out to use the defaults (25-40 seconds).
# AI_TIMEOUT_MS=40000

# --- App ----------------------------------------------------------------------
DATABASE_URL=postgres://pactpay:pactpay_dev_only@127.0.0.1:5432/pactpay
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CHANNEL3_API_KEY=
# 1 = require sign-in (hosted). Leave empty locally to allow guest use.
PACTPAY_REQUIRE_LOGIN=
PACTPAY_DEMO_USERNAME=
PACTPAY_DEMO_PASSWORD=
