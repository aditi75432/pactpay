# Copy to apps/web/.env.local and fill in the values you use locally.
# Use test/sandbox credentials only.

# App/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pactpay
PACTPAY_REQUIRE_LOGIN=0

# PayPal Sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Channel3
CHANNEL3_API_KEY=

# AI provider: Groq is the hosted configuration for this deployment.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_MS=12000

# Optional alternative providers for local testing only.
# MODEL_API_KEY=
# META_MODEL=muse-spark-1.3
# BASETEN_API_KEY=
# BASETEN_MODEL=meta-models/muse-spark-open
# AI_PROVIDER=meta
# AI_PROVIDER=baseten
